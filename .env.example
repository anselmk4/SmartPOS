# Supabase PostgreSQL Database Connection Strings
# Replace [PROJECT_REF] and [YOUR-PASSWORD] with your actual Supabase credentials

# Transaction Pooler (Used by Prisma Client in Serverless / Next.js API Routes - Port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection (Used by Prisma CLI for migrations and schema pushing - Port 5432)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Supabase Storage & Public API Configuration
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"

# PawaPay Pan-African Mobile Money Gateway (Optional - Sandbox Simulation enabled if omitted)
PAWAPAY_API_TOKEN=""
PAWAPAY_ENVIRONMENT="sandbox" # "sandbox" or "production"

# Next.js Environment & Domain
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="https://globalpos.app"

# Security & Authentication Secrets (Required in Production)
JWT_SECRET="" # Generate with: openssl rand -base64 32
ADMIN_EMAIL="info@kuettu.com"
ADMIN_PASSWORD="" # Strong password for SuperAdmin Console
PAWAPAY_WEBHOOK_SECRET=""

# Twilio SMS API Gateway (Optional - Sandbox Simulation enabled if omitted)
TWILIO_ACCOUNT_SID="" # ex: ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER="" # ex: +1234567890 (or TWILIO_MESSAGING_SERVICE_SID)
