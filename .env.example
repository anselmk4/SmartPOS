# Supabase Connection URLs (Multi-tenant SaaS PostgreSQL)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Supabase Public Keys & URL (Direct Cloud Sync)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"

# PawaPay Pan-African Mobile Money Gateway (Optional - Sandbox Simulation enabled if omitted)
PAWAPAY_API_TOKEN=""
PAWAPAY_ENVIRONMENT="sandbox" # "sandbox" or "production"

# Next.js Environment & Domain
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="https://globalpos.app"

# Security & Authentication Secrets (Required in Production)
JWT_SECRET="" # Generate with: openssl rand -base64 32
ADMIN_EMAIL="info@kuettu.com"
ADMIN_PASSWORD="" # Strong password for SuperAdmin Console
PAWAPAY_WEBHOOK_SECRET=""

# Twilio SMS API Gateway (Optional - Sandbox Simulation enabled if omitted)
TWILIO_ACCOUNT_SID="" # ex: ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER="" # ex: +1234567890 (or TWILIO_MESSAGING_SERVICE_SID)

# Resend Email Gateway (Domain: globalpos.app)
RESEND_API_KEY="" # ex: re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="Kuettu Global POS <noreply@globalpos.app>"